# ============================================================
# Environment Variables Example for Personal OS
# Copy this file to .env.local and fill in the values
# ============================================================

# Portfolio Contact & Public Configuration
NEXT_PUBLIC_SITE_URL=https://ronit-kadwane.vercel.app/
NEXT_PUBLIC_CONTACT_EMAIL=kadwane.ronit@gmail.com
# Optional: Set if you want to display phone on the site, otherwise omitted for privacy
# NEXT_PUBLIC_CONTACT_PHONE=+919824337236

# Optional: Email Delivery Service for /api/contact (e.g., Resend, Sendgrid, Postmark)
# RESEND_API_KEY=re_your_api_key_here
# CONTACT_RECIPIENT_EMAIL=kadwane.ronit@gmail.com

# Telegram Bot Instant Push Notifications for /api/contact
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

